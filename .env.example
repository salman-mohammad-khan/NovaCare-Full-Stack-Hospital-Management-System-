MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=NovaCare
PORT=4000
VITE_API_BASE_URL=/api

# JWT auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h

# Optional: only if the API and the web app are on different origins
CORS_ORIGIN=

# Health assistant. Optional hosted model on Amazon Bedrock: create a Bedrock API key in the AWS console and keep it out of git.
# AWS_BEARER_TOKEN_BEDROCK=
# BEDROCK_REGION=ap-south-1
# BEDROCK_MODEL_ID=openai.gpt-oss-20b-1:0
# Let two clear model answers cancel a rule's false emergency alarm (never a self-harm one). Off by default.
# BEDROCK_MAY_DOWNGRADE=false
# Use the small local model when Bedrock fails (default: rules and templates answer instead)
# BEDROCK_LOCAL_FALLBACK=false

# Local LLM (used without a Bedrock key)
LLM_ENABLED=true
LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen3.5:2b
LLM_TIMEOUT_MS=30000
LLM_REPLY=false
